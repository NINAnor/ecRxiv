forest.NiNtypes <- colnames(forest.ref.cov[["Nitrogen"]])
forest.NiNtypes[-x] <- substr(forest.NiNtypes[-x], 1, nchar(forest.NiNtypes[-x])-1)
forest.NiNtypes
# 2 indicator-value indicators: Moisture, "Nitrogen"
indEll.n=2
# creating a table to hold:
# for every indicator: the 0.5 quantile (median), 0.025 quantile and  0.975 quantile for each NiN-type (3 metrics -> 3 columns per indicator), for Heat_requirement in alpine/arctic systems we do 0.05 quantile and  0.95 quantile and ignore the former as it is a one-sided indicator
# for every nature type (nrows)
tab <- matrix(ncol=3*indEll.n, nrow=24 ) # 24 basic ecosystem types
# coercing the values into the table
myQuantiles <- c(0.025, 0.5, 0.95) # the lowest quantile will not be used in this one-sided indicator
for (i in 1:length(x) ) {
tab[i,1:3] <- quantile(as.matrix(forest.ref.cov[["Moisture"]][,x[i]]),probs=myQuantiles,na.rm=T)
tab[i,4:6] <- quantile(as.matrix(forest.ref.cov[["Nitrogen"]][,x[i]]),probs=myQuantiles,na.rm=T)
}
tab <- as.data.frame(tab)
tab$NiN <- NA
tab$NiN[1:length(x)] <- names(forest.ref.cov[[1]])[x]
tab
# NiN-types represented by several species lists
forest.NiNtypes2 <- forest.NiNtypes[-x]
unique(forest.NiNtypes2)
grep(pattern=unique(forest.NiNtypes2)[1], x=forest.NiNtypes) # finds columns in e.g. colnames(forest.ref.cov[["Light"]]) that match the first NiN-type
for (i in 1:length(unique(forest.NiNtypes2)) ) {
tab[length(x)+i,1:3] <- quantile(as.matrix(forest.ref.cov[["Moisture"]][,grep(pattern=unique(forest.NiNtypes2)[i], x=forest.NiNtypes)]),probs=myQuantiles,na.rm=T)
tab[length(x)+i,4:6] <- quantile(as.matrix(forest.ref.cov[["Nitrogen"]][,grep(pattern=unique(forest.NiNtypes2)[i], x=forest.NiNtypes)]),probs=myQuantiles,na.rm=T)
tab$NiN[length(x)+i] <- unique(forest.NiNtypes2)[i]
}
tab
# when species lists represent several NiN-types
# does not apply here
#tab$NiN
#tab <- rbind(tab,tab[c(27:30,42,44,47,55:57,60,62,71,83,85),])
#tab$NiN[c(27:30,42,44,47,55:57,60,62,71,83,85,88:102)] <- c("T3-C3","T3-C9","T3-C5","T3-C8",
#                                                            "T7-C13","T7-C7","T22-C2","T32-C1",
#                                                            "T32-C3","T32-C7","T45-C1","V10-C1","T22-C1",
#                                                            "T32-C5","T32-C21",
#
#                                                            "T3-C6","T3-C12","T3-C5","T3-C11",
#                                                            "T7-C14","T7-C9","T22-C4","T32-C2",
#                                                            "T32-C4","T32-C8","T45-C2","V10-C2","T22-C3",
#                                                            "T32-C20","T32-C6")
#tab
# making it a proper data frame
dim(tab)
round(tab[,1:6],digits=2)
colnames(tab) <- c("Moist_q2.5","Moist_q50","Moist_q97.5",
"Nitrogen_q2.5","Nitrogen_q50","Nitrogen_q97.5",
"NiN")
summary(tab)
tab$NiN <- gsub("C", "C-", tab$NiN) # add extra hyphen after C for NiN-types
tab
# restructuring into separate indicators for lower (q2.5) and higher (q97.5) than reference value (=median, q50)
y.Moist <- numeric(length=nrow(tab)*2)
y.Moist[((1:dim(tab)[1])*2)-1] <- tab$Moist_q2.5
y.Moist[((1:dim(tab)[1])*2)] <- tab$Moist_q97.5
y.Nitrogen <- numeric(length=nrow(tab)*2)
y.Nitrogen[((1:dim(tab)[1])*2)-1] <- tab$Nitrogen_q2.5
y.Nitrogen[((1:dim(tab)[1])*2)] <- tab$Nitrogen_q97.5
# creating final objects holding the reference and limit values for all indicators
# ref object for indicators
forest.ref.cov.val <- data.frame( grunn=c(rep(rep(tab$NiN,each=2),indEll.n)),
county=rep('all',(nrow(tab)*2*indEll.n)),
region=rep('all',(nrow(tab)*2*indEll.n)),
Ind=c(rep(c('Moist1','Moist2'),nrow(tab)),
rep(c('Nitrogen1','Nitrogen2'),nrow(tab))
),
Rv=c(rep(tab$Moist_q50,each=2),
rep(tab$Nitrogen_q50,each=2)
),
Gv=c(y.Moist,y.Nitrogen),
maxmin=c(rep(c(1,12),nrow(tab)), # 12 levels of moisture
rep(c(1,9),nrow(tab))  # 9 levels of nitrogen
)
)
forest.ref.cov.val
forest.ref.cov.val$grunn <- as.factor(forest.ref.cov.val$grunn)
forest.ref.cov.val$Ind <- as.factor(forest.ref.cov.val$Ind)
summary(forest.ref.cov.val)
#### calculating scaled and non-truncated values for the indicators based on the dataset ####
# drop geometry
ANO.forest <- ANO.forest %>%
mutate(
X = st_coordinates(.)[, 1],
Y = st_coordinates(.)[, 2]
) %>%
st_drop_geometry()
for (i in 1:nrow(ANO.forest) ) {  #
tryCatch({
print(i)
print(paste(ANO.forest$ano_flate_id[i]))
print(paste(ANO.forest$ano_punkt_id[i]))
#    ANO.forest$Hovedoekosystem_sirkel[i]
#    ANO.forest$Hovedoekosystem_rute[i]
# if the ANO.hovedtype exists in the forest reference
if ( ANO.forest$hovedtype_rute[i] %in% unique(sub("\\-.*", "", forest.ref.cov.val$grunn)) ) {
# if there is any species present in current ANO point
if ( length(ANO.sp.ind[ANO.sp.ind$parentglobalid==as.character(ANO.forest$globalid[i]),'Species']) > 0 ) {
# Nitrogen
dat <- ANO.sp.ind[ANO.sp.ind$parentglobalid==as.character(ANO.forest$globalid[i]),c('art_dekning','Nitrogen')]
ANO.forest[i,'richness'] <- nrow(dat)
dat <- dat[!is.na(dat$Nitrogen),]
if ( nrow(dat)>0 ) {
val <- sum(dat[,'art_dekning'] * dat[,'Nitrogen'],na.rm=T) / sum(dat[,'art_dekning'],na.rm=T)
#          # lower part of distribution
#          ref <- forest.ref.cov.val[forest.ref.cov.val$Ind=='Nitrogen1' & forest.ref.cov.val$grunn==as.character(ANO.forest[i,"kartleggingsenhet_1m2"]),'Rv']
#          lim <- forest.ref.cov.val[forest.ref.cov.val$Ind=='Nitrogen1' & forest.ref.cov.val$grunn==as.character(ANO.forest[i,"kartleggingsenhet_1m2"]),'Gv']
#          maxmin <- forest.ref.cov.val[forest.ref.cov.val$Ind=='Nitrogen1' & forest.ref.cov.val$grunn==as.character(ANO.forest[i,"kartleggingsenhet_1m2"]),'maxmin']
#          # normalisation
#          ANO.forest[i,'Nitrogen1'] <- ec_normalise(variable = val, x0 = maxmin, x60 = lim, x100 = ref, fun = "linear")
# upper part of distribution
ref <- forest.ref.cov.val[forest.ref.cov.val$Ind=='Nitrogen2' & forest.ref.cov.val$grunn==as.character(ANO.forest[i,"kartleggingsenhet_1m2"]),'Rv']
lim <- forest.ref.cov.val[forest.ref.cov.val$Ind=='Nitrogen2' & forest.ref.cov.val$grunn==as.character(ANO.forest[i,"kartleggingsenhet_1m2"]),'Gv']
maxmin <- forest.ref.cov.val[forest.ref.cov.val$Ind=='Nitrogen2' & forest.ref.cov.val$grunn==as.character(ANO.forest[i,"kartleggingsenhet_1m2"]),'maxmin']
# normalisation
ANO.forest[i,'Nitrogen2'] <- ec_normalise(variable = val, x0 = maxmin, x60 = lim, x100 = ref, fun = "linear")
}
}
}
}, error=function(e){cat("ERROR :",conditionMessage(e), "\n")})
}
# generate overall Nitrogen indicator
ANO.forest$Nitrogen <- ANO.forest$Nitrogen2
#ANO.forest$Nitrogen1[ANO.forest$Nitrogen1==1] <- NA
#ANO.forest$Nitrogen2[ANO.forest$Nitrogen2==1] <- NA
# add geometry again
ANO.forest <- ANO.forest %>%
st_as_sf(coords = c("X", "Y"), crs = st_crs(ANO.geo))
## Fit ordered beta regression null-model with a random effect
# Norway
nitrogen.no <- glmmTMB(
Nitrogen ~ 1 + (1|ano_flate_id),
data = ANO.forest,
family = ordbeta
)
summary(nitrogen.no)
# regions
nitrogen.re <- glmmTMB(
Nitrogen ~ 0 + region + (1|ano_flate_id),
data = ANO.forest,
family = ordbeta
)
summary(nitrogen.re)
NO_FUNI_004_table <- tibble(
Region = c("Norway", "Central Norway", "Eastern Norway", "Northern Norway", "Southern Norway", "Western Norway"),
indicator_value = c(plogis(summary(nitrogen.no)$coef$cond[,1]), plogis(summary(nitrogen.re)$coef$cond[,1])),
CI_upper = c(plogis(summary(nitrogen.no)$coef$cond[,1]+1.96*summary(nitrogen.no)$coef$cond[,2]), plogis(summary(nitrogen.re)$coef$cond[,1]+1.96*summary(nitrogen.re)$coef$cond[,2])),
CI_lower = as.numeric(plogis(summary(nitrogen.no)$coef$cond[,1]-1.96*summary(nitrogen.no)$coef$cond[,2]), plogis(summary(nitrogen.re)$coef$cond[,1]-1.96*summary(nitrogen.re)$coef$cond[,2]))
)
NO_FUNI_004_table
b0 <- fixef(nitrogen.no)$cond["(Intercept)"]
se_b0 <- sqrt(vcov(nitrogen.no)$cond["(Intercept)", "(Intercept)"])
# Dispersion parameter (For glmmTMB this is usually on the response/positive scale via sigma() )
phi <- sigma(nitrogen.no)
# draw estimates and backtransform from logit-scale
eta_draws <- rnorm(1000, mean = b0, sd = se_b0)
mu_draws  <- plogis(eta_draws)
nitrogen.no_sim <- rbeta(
n = 1000,
shape1 = mu_draws * phi,
shape2 = (1 - mu_draws) * phi
)
hist(mu_draws)
hist(nitrogen.no_sim)
phi
sigma(nitrogen.re)
## Norway
# Fixed-effect intercept and SE
b0 <- fixef(nitrogen.no)$cond["(Intercept)"]
se_b0 <- sqrt(vcov(nitrogen.no)$cond["(Intercept)", "(Intercept)"])
# Dispersion parameter (For glmmTMB this is usually on the response/positive scale via sigma() )
phi <- sigma(nitrogen.no)
# draw estimates and backtransform from logit-scale
eta_draws <- rnorm(1000, mean = b0, sd = se_b0)
mu_draws  <- plogis(eta_draws)
# draw from beta distribution to consider the dispersion parameter
nitrogen.no_sim <- rbeta(
n = 1000,
shape1 = mu_draws * phi,
shape2 = (1 - mu_draws) * phi
)
## regions
b_re <- fixef(nitrogen.re)$cond
vc_re <- vcov(nitrogen.re)$cond
phi <- sigma(nitrogen.re)
eta_draws <- MASS::mvrnorm(
n = 1000,
mu = b_re,
Sigma = vc_re
)
mu_draws <- plogis(eta_draws)
nitrogen_re_sim <- do.call(
rbind,
lapply(seq_along(b_re), function(i) {
region <- names(b_re)[i]
mu_i <- mu_draws[, i]
sim <- rbeta(
n = 1000,
shape1 = mu_i * phi,
shape2 = (1 - mu_i) * phi
)
data.frame(
region = region,
#      draw = 1:10,
#      eta = eta_draws[, i],
#      mu = mu_i,
#      dispersion = phi,
sim = sim
)
})
)
nitrogen_re_sim$region <- sub("^region", "", nitrogen_re_sim$region)
nitrogen_re_sim
# combining nitrogen_no_sim and nitrogen_re_sim
NO_FUNI_004_sim <- rbind(data.frame(region = 'Norway', sim = nitrogen.no_sim), nitrogen_re_sim)
View(NO_FUNI_004_sim)
with(NO_FUNI_004_sim,plot(region,sim))
with(NO_FUNI_004_sim,plot(region,sim,xlim=c(0,1)))
summary(NO_FUNI_004_sim)
with(NO_FUNI_004_sim,plot(as.factor(region),sim))
